# Copy this file to `.env` and fill it in. `.env` is gitignored.

# From Google Cloud Console -> APIs & Services -> Credentials -> Create API key,
# with "YouTube Data API v3" enabled for the project.
YOUTUBE_API_KEY=

# Your channel ID (starts with UC...). Find it at youtube.com/account_advanced.
YOUTUBE_CHANNEL_ID=

# Optional alternative to the ID above — your @handle, e.g. nicvandewetering
# YOUTUBE_HANDLE=

# --- optional -------------------------------------------------------------

# Port the local server listens on.
# PORT=4747

# Set to 0.0.0.0 to reach the control page from your phone on the same Wi-Fi.
# Do that only together with CONTROL_TOKEN below.
# HOST=127.0.0.1

# How often to ask YouTube for the subscriber count, in seconds (minimum 15).
# 30s = ~2,880 calls/day, well inside the free 10,000 unit daily quota.
# POLL_SECONDS=30

# If set, every change requires this token: open /control.html?token=YOUR_TOKEN
# CONTROL_TOKEN=
