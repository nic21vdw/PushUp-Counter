# Copy this file to `.env` and fill it in. `.env` is gitignored.

# From Google Cloud Console -> APIs & Services -> Credentials -> Create API key,
# with "YouTube Data API v3" enabled for the project.
YOUTUBE_API_KEY=

# Your channel ID (starts with UC...). Find it at youtube.com/account_advanced.
YOUTUBE_CHANNEL_ID=

# Optional alternative to the ID above — your @handle, e.g. nicvandewetering
# YOUTUBE_HANDLE=

# --- optional -------------------------------------------------------------

# Push-ups you owe per subscriber gained while live. One for one is the point;
# this exists for the day the arithmetic stops being survivable.
# PUSHUPS_PER_SUB=1

# Port the local server listens on.
# PORT=4747

# The server only listens on localhost. There is nothing to control remotely —
# the overlay counts on the machine the webcam is plugged into — so leave this
# alone unless you know why you are changing it.
# HOST=127.0.0.1

# How often to ask YouTube for the subscriber count, in seconds (minimum 15).
# 30s = ~2,880 calls/day, well inside the free 10,000 unit daily quota.
# POLL_SECONDS=30

# Only subscribers gained during a stream add push-ups. Starting the server
# after being off this many hours begins a new stream; a shorter gap (a crash,
# a reboot mid-stream) picks the session back up where it left off.
# Use "off" to never start one automatically, or 0 to always start fresh.
# NEW_STREAM_AFTER_HOURS=6

# Phone control panel: start set, +1, -1, undo, end set from a phone on the
# same Wi-Fi. Off unless a PIN of 4 to 12 digits is set. It runs on its own
# port so the main server above stays on localhost, and it only answers
# private-network addresses (192.168.x.x, 10.x.x.x and so on).
# PHONE_PIN=
# PHONE_PORT=4748

# --- Twitch and Kick (optional) --------------------------------------------
# Each is also a switch in the control panel, off until you turn it on. Only
# gains while that channel is live count. See "Twitch subs and Kick
# follows/subs" in the README.

# Twitch app (dev.twitch.tv/console) and a user token for your own account with
# the channel:read:subscriptions scope. The secret and refresh token let the
# server renew the user token when it expires.
TWITCH_CLIENT_ID=
TWITCH_ACCESS_TOKEN=
TWITCH_BROADCASTER_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REFRESH_TOKEN=

# Kick app (client credentials), or a user token instead. KICK_CHANNEL is the
# channel slug; KICK_BROADCASTER_ID can be used instead for subs.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_ACCESS_TOKEN=
KICK_CHANNEL=
KICK_BROADCASTER_ID=

# How often to ask Twitch and Kick, in seconds.
# SOURCES_POLL_SECONDS=30

# Push-ups per Twitch sub / Kick follow / Kick sub. Default: PUSHUPS_PER_SUB.
# PUSHUPS_PER_TWITCH_SUB=1
# PUSHUPS_PER_KICK_FOLLOW=1
# PUSHUPS_PER_KICK_SUB=1
