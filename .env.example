# Every setting in here is optional — you do not need a .env file at all.
#
# Without one, you set the push-up target yourself on the control page and the
# camera (or a shared window) counts reps off it. Fill in the YouTube keys below
# only if you additionally want new subscribers to ADD push-ups.
#
# To use it: copy this file to `.env`. `.env` is gitignored.

# --- YouTube subscriber tracking (optional) --------------------------------
#
# Leave these blank to run without it. Nothing polls, and no error is shown.
# Both a key and one of ID/handle are required for it to switch on.

# From Google Cloud Console -> APIs & Services -> Credentials -> Create API key,
# with "YouTube Data API v3" enabled for the project.
# YOUTUBE_API_KEY=

# Your channel ID (starts with UC...). Find it at youtube.com/account_advanced.
# YOUTUBE_CHANNEL_ID=

# Alternative to the ID above — your @handle, e.g. nicvandewetering
# YOUTUBE_HANDLE=

# --- optional -------------------------------------------------------------

# Port the local server listens on.
# PORT=4747

# Set to 0.0.0.0 to reach the control page from your phone on the same Wi-Fi.
# Do that only together with CONTROL_TOKEN below.
# HOST=127.0.0.1

# How often to ask YouTube for the subscriber count, in seconds (minimum 15).
# 30s = ~2,880 calls/day, well inside the free 10,000 unit daily quota.
# POLL_SECONDS=30

# If set, every change requires this token: open /control.html?token=YOUR_TOKEN
# CONTROL_TOKEN=

# Only subscribers gained during a stream add push-ups. Starting the server
# after being off this many hours begins a new stream; a shorter gap (a crash,
# a reboot mid-stream) picks the session back up where it left off.
# Use "off" to never start one automatically, or 0 to always start fresh.
# NEW_STREAM_AFTER_HOURS=6
