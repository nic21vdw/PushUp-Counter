{
  "name": "pushup-counter",
  "version": "1.0.0",
  "description": "YouTube subscriber-driven push-up counter with webcam rep detection and a transparent OBS overlay",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "fetch-assets": "node fetch-assets.mjs",
    "test": "node --test tests/*.test.mjs",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "lint-staged": {
    "*.{js,mjs,json,css,html,md}": "prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6"
  }
}
