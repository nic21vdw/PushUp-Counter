# The API key lives in .env. The wildcard matters: a .env.backup or .env.old
# made while editing is just as sensitive and would otherwise be committable.
.env
.env.*
!.env.example
state.json
state.json.tmp
state.json.bak
state.json.broken
state-history.jsonl
.admin-token
node_modules/
.DS_Store

# Pose model + WASM runtime for the camera page (~24 MiB).
# Populate with: npm run fetch-assets
public/vendor/
.server.pid
